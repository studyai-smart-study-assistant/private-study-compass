import("//build/config/android/rules.gni")

# Study AI extension point. Deliberately minimal: no network, no secrets.
# Future phases (AI API, MCP browser agent) register implementations of
# StudyAiAgentBridge at startup; nothing else in the browser depends on them.
android_library("java") {
  sources = [
    "java/org/studyai/browser/StudyAiAgentBridge.java",
    "java/org/studyai/browser/StudyAiBridgeRegistry.java",
  ]
  deps = [
    "//base:base_java",
  ]
}
